FROM alpine:3.24 AS runtime-files

RUN apk add --no-cache ca-certificates \
    && mkdir -p /data /var/lib/apk-registry /tmp \
    && chown 10001:10001 /data \
    && chown 10001:10001 /var/lib/apk-registry \
    && chmod 1777 /tmp

FROM scratch

ARG TARGETPLATFORM

COPY --from=runtime-files /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=runtime-files --chown=10001:10001 /data /data
COPY --from=runtime-files --chown=10001:10001 /var/lib/apk-registry /var/lib/apk-registry
COPY --from=runtime-files --chmod=1777 /tmp /tmp
COPY --chmod=0755 ${TARGETPLATFORM}/apk-registry /usr/local/bin/apk-registry

USER 10001:10001

EXPOSE 8080 9094
ENTRYPOINT ["/usr/local/bin/apk-registry"]
